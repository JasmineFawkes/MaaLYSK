{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "custom_action": {
      "enum": [
        "DisableNode",
        "NodeOverride",
        "ResetCount",
        "SubTask",
        "OcrReport"
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/DisableNode"
    },
    {
      "$ref": "#/$defs/NodeOverride"
    },
    {
      "$ref": "#/$defs/ResetCount"
    },
    {
      "$ref": "#/$defs/SubTask"
    },
    {
      "$ref": "#/$defs/OcrReport"
    }
  ],
  "$defs": {
    "RequiredParam": {
      "anyOf": [
        {
          "required": ["custom_action_param"]
        },
        {
          "required": ["custom_action_param_code"]
        }
      ]
    },
    "DataOnlyAction": {
      "description": "数据节点：只有custom_action_param，没有custom_action，用于存放其他action读取的数据",
      "properties": {
        "custom_action": false,
        "custom_action_param": {
          "type": "object"
        }
      },
      "required": ["custom_action_param"]
    },
    "DisableNode": {
      "allOf": [
        {
          "$ref": "#/$defs/RequiredParam"
        }
      ],
      "properties": {
        "custom_action": {
          "const": "DisableNode",
          "description": "将特定 node 设置为 disable 状态 。"
        },
        "custom_action_param": {
          "type": "object",
          "properties": {
            "node_name": {
              "type": "string",
              "description": "需要设置为 disable 状态的节点名称"
            }
          },
          "required": ["node_name"],
          "unevaluatedProperties": false
        }
      }
    },
    "NodeOverride": {
      "allOf": [
        {
          "$ref": "#/$defs/RequiredParam"
        }
      ],
      "properties": {
        "custom_action": {
          "const": "NodeOverride",
          "description": "在 node 中执行 pipeline_override 。"
        },
        "custom_action_param": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "description": "节点覆盖配置，键为节点名称，值为覆盖参数对象",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "ResetCount": {
      "allOf": [
        {
          "$ref": "#/$defs/RequiredParam"
        }
      ],
      "properties": {
        "custom_action": {
          "const": "ResetCount",
          "description": "重置指定节点的命中计数。"
        },
        "custom_action_param": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "description": "需要重置命中计数的节点名称列表",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "strict": {
              "type": "boolean",
              "description": "任一节点重置失败时，当前 action 是否视为失败",
              "default": false
            }
          },
          "required": ["nodes"],
          "unevaluatedProperties": false
        }
      }
    },
    "SubTask": {
      "allOf": [
        {
          "$ref": "#/$defs/RequiredParam"
        }
      ],
      "properties": {
        "custom_action": {
          "const": "SubTask",
          "description": "按顺序执行 custom_action_param.sub 中的子任务。"
        },
        "custom_action_param": {
          "type": "object",
          "properties": {
            "sub": {
              "type": "array",
              "description": "按顺序执行的子任务名称列表",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "continue": {
              "type": "boolean",
              "description": "任一子任务失败后是否继续执行后续子任务",
              "default": false
            },
            "strict": {
              "type": "boolean",
              "description": "任一子任务失败时，当前 action 是否视为失败",
              "default": true
            }
          },
          "required": ["sub"],
          "unevaluatedProperties": false
        }
      }
    },
    "OcrReport": {
      "allOf": [
        {
          "$ref": "#/$defs/RequiredParam"
        }
      ],
      "properties": {
        "custom_action": {
          "const": "OcrReport",
          "description": "运行指定识别节点，将识别结果打印到 UI，可选用追加写文本文件的方式导出。"
        },
        "custom_action_param": {
          "type": "object",
          "properties": {
            "recognition": {
              "type": "string",
              "minLength": 1,
              "description": "要运行的 OCR 识别节点名（必填）"
            },
            "format": {
              "type": "string",
              "description": "自定义输出格式，{result} 会被替换为识别到的最佳文本；省略时直接打印识别文本"
            },
            "export": {
              "type": "boolean",
              "default": false,
              "description": "是否追加写入文本文件（默认 false）"
            },
            "filename": {
              "type": "string",
              "description": "导出文件名，自动补 .txt 后缀；省略时使用默认名"
            }
          },
          "required": ["recognition"],
          "unevaluatedProperties": false
        }
      }
    }
  }
}
