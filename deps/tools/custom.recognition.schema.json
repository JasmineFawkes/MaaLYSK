{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "Rect": {
            "type": "array",
            "items": {
                "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "Recognition result box as [x, y, w, h]."
        },
        "ExampleRecognitionParam": {
            "type": "object",
            "properties": {
                "node": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Existing recognition node to reuse through context.run_recognition()."
                },
                "template_node": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Alias of node, kept for examples that name reusable recognition nodes this way."
                },
                "box": {
                    "$ref": "#/$defs/Rect"
                },
                "detail": {
                    "type": "object",
                    "description": "Extra detail object returned with CustomRecognition.AnalyzeResult."
                }
            },
            "additionalProperties": true
        },
        "CompareNumParam": {
            "type": "object",
            "properties": {
                "recognition": {
                    "type": "string",
                    "minLength": 1,
                    "description": "要运行的 OCR 识别节点名（必填）"
                },
                "expected": {
                    "type": ["number", "string"],
                    "description": "期望值（单值模式用），数字或数字字符串"
                },
                "operator": {
                    "type": "string",
                    "enum": [">", ">=", "<", "<="],
                    "description": "比较符（单值模式必填）"
                },
                "min": {
                    "type": "number",
                    "description": "区间下界数值，可只给下界做单向判断"
                },
                "min_op": {
                    "type": "string",
                    "enum": [">=", ">"],
                    "description": "下界比较符，默认 \">=\""
                },
                "max": {
                    "type": "number",
                    "description": "区间上界数值，可只给上界做单向判断"
                },
                "max_op": {
                    "type": "string",
                    "enum": ["<=", "<"],
                    "description": "上界比较符，默认 \"<=\""
                },
                "roi": {
                    "$ref": "#/$defs/Rect",
                    "description": "可选 [x, y, w, h]，限定 OCR 区域"
                }
            },
            "required": ["recognition"],
            "additionalProperties": true,
            "description": "单值模式需 expected+operator；区间模式需 min 和/或 max（每侧可用 min_op/max_op 指定开闭）。"
        }
    },
    "type": "object",
    "properties": {
        "custom_recognition": {
            "type": "string",
            "description": "Registered custom recognition name."
        },
        "custom_recognition_param": {
            "description": "Parameters passed to the registered custom recognition."
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "custom_recognition": {
                        "const": "ExampleRecognition"
                    }
                },
                "required": [
                    "custom_recognition"
                ]
            },
            "then": {
                "properties": {
                    "custom_recognition_param": {
                        "$ref": "#/$defs/ExampleRecognitionParam"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "custom_recognition": {
                        "const": "CompareNum"
                    }
                },
                "required": [
                    "custom_recognition"
                ]
            },
            "then": {
                "properties": {
                    "custom_recognition_param": {
                        "$ref": "#/$defs/CompareNumParam"
                    }
                }
            }
        }
    ]
}
